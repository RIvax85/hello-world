                "title": "Store V\u00e9rand\u00e0"
            }
        },
        {
            "action": "notify.mobile_app_nixel_8",
            "data": {
                "message": "\ud83c\udf27\ufe0f Pluie d\u00e9tect\u00e9e \u2014 Store v\u00e9rand\u00e0 rentr\u00e9 automatiquement.",
                "title": "Store V\u00e9rand\u00e0"
            }
        }
    ],
    "mode": "single"
