{
  "id": "1784990109169",
  "alias": "Arrosage Massifs fleurs (météo-adaptatif)",
  "description": "Arrose les massifs (valve 2, tuyau préperforé) 1 jour sur 2 à 6h00, skip si pluie prévue >= 4mm. Durée 20 min via le timer intégré du GIEX (coupure auto).",
  "triggers": [
    {
      "trigger": "time",
      "at": "06:00:00"
    }
  ],
  "conditions": [],
  "actions": [
    {
      "action": "weather.get_forecasts",
      "target": {
        "entity_id": "weather.meteo_france_forecast_for_city_antony_ile_de_france_92_fr_antony"
      },
      "data": {
        "type": "daily"
      },
      "response_variable": "fc"
    },
    {
      "variables": {
        "precip": "{{ fc['weather.meteo_france_forecast_for_city_antony_ile_de_france_92_fr_antony'].forecast[0].precipitation | float(0) }}",
        "even_day": "{{ now().toordinal() % 2 == 0 }}"
      }
    },
    {
      "condition": "template",
      "value_template": "{{ precip < 4 and even_day }}"
    },
    {
      "action": "number.set_value",
      "target": {
        "entity_id": "number.arrosage_automatique_timer_2"
      },
      "data": {
        "value": 20
      }
    },
    {
      "delay": {
        "seconds": 3
      }
    },
    {
      "action": "switch.turn_on",
      "target": {
        "entity_id": "switch.arrosage_automatique_valve_2"
      }
    },
    {
      "action": "notify.mobile_app_pixel_8",
      "data": {
        "title": "🌸 Arrosage massifs",
        "message": "Massifs arrosés 20 min. Pluie prévue {{ precip }}mm."
      }
    },
    {
      "action": "notify.mobile_app_nixel_8",
      "data": {
        "title": "🌸 Arrosage massifs",
        "message": "Massifs arrosés 20 min. Pluie prévue {{ precip }}mm."
      }
    }
  ],
  "mode": "single"
}