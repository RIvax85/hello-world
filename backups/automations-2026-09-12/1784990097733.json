{
  "id": "1784990097733",
  "alias": "Arrosage Potager (météo-adaptatif)",
  "description": "Arrose le potager (valve 1) 1 jour sur 2 à 6h30 (tous les jours si prévision > 30°C), skip si pluie prévue >= 4mm. Durée 25 min via le timer intégré du GIEX (coupure auto).",
  "triggers": [
    {
      "trigger": "time",
      "at": "06:30:00"
    }
  ],
  "conditions": [],
  "actions": [
    {
      "action": "weather.get_forecasts",
      "target": {
        "entity_id": "weather.meteo_france_forecast_for_city_antony_ile_de_france_92_fr_antony"
      },
      "data": {
        "type": "daily"
      },
      "response_variable": "fc"
    },
    {
      "variables": {
        "today": "{{ fc['weather.meteo_france_forecast_for_city_antony_ile_de_france_92_fr_antony'].forecast[0] }}",
        "precip": "{{ today.precipitation | float(0) }}",
        "tmax": "{{ today.temperature | float(0) }}",
        "even_day": "{{ now().toordinal() % 2 == 0 }}"
      }
    },
    {
      "condition": "template",
      "value_template": "{{ precip < 4 and (even_day or tmax > 30) }}"
    },
    {
      "action": "number.set_value",
      "target": {
        "entity_id": "number.arrosage_automatique_timer_1"
      },
      "data": {
        "value": 25
      }
    },
    {
      "delay": {
        "seconds": 3
      }
    },
    {
      "action": "switch.turn_on",
      "target": {
        "entity_id": "switch.arrosage_automatique_valve_1"
      }
    },
    {
      "action": "notify.mobile_app_pixel_8",
      "data": {
        "title": "💧 Arrosage potager",
        "message": "Potager arrosé 25 min. Pluie prévue {{ precip }}mm — T°max {{ tmax }}°C."
      }
    },
    {
      "action": "notify.mobile_app_nixel_8",
      "data": {
        "title": "💧 Arrosage potager",
        "message": "Potager arrosé 25 min. Pluie prévue {{ precip }}mm — T°max {{ tmax }}°C."
      }
    }
  ],
  "mode": "single"
}