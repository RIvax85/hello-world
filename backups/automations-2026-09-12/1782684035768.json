{
  "id": "1782684035768",
  "alias": "Femme de ménage — Réarmement alarme",
  "description": "Réarme l'alarme le mardi à 13h30 si personne à la maison. Inactif pendant le mode vacances, SAUF le 11 août 2026.",
  "triggers": [
    {
      "trigger": "time",
      "at": "13:30:00"
    }
  ],
  "conditions": [
    {
      "condition": "time",
      "weekday": [
        "tue"
      ]
    },
    {
      "condition": "template",
      "value_template": "{{ is_state('input_boolean.mode_vacances','off') or now().strftime('%Y-%m-%d') == '2026-08-11' }}"
    },
    {
      "condition": "numeric_state",
      "entity_id": "zone.home",
      "below": 1
    }
  ],
  "actions": [
    {
      "action": "alarm_control_panel.alarm_arm_away",
      "target": {
        "entity_id": "alarm_control_panel.alarmo"
      }
    },
    {
      "action": "notify.mobile_app_pixel_8",
      "data": {
        "title": "🔒 Alarme réarmée",
        "message": "Alarme réarmée en mode Absence après le ménage."
      }
    },
    {
      "action": "notify.mobile_app_nixel_8",
      "data": {
        "title": "🔒 Alarme réarmée",
        "message": "Alarme réarmée en mode Absence après le ménage."
      }
    }
  ],
  "mode": "single"
}