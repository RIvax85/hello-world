{
  "id": "1782683822766",
  "alias": "Clim Salon — Démarrage automatique si chaud",
  "description": "Démarre la clim en mode cool 23°C si temp salon > 29°C, quelqu'un à la maison, après 10h",
  "triggers": [
    {
      "trigger": "numeric_state",
      "entity_id": "sensor.capteur_temperature_salon_temperature",
      "above": 29,
      "for": {
        "minutes": 10
      }
    }
  ],
  "conditions": [
    {
      "condition": "numeric_state",
      "entity_id": "zone.home",
      "above": 0
    },
    {
      "condition": "time",
      "after": "10:00:00"
    },
    {
      "condition": "state",
      "entity_id": "climate.salon_clim_salon_climate",
      "state": [
        "off",
        "idle"
      ],
      "attribute": "hvac_action"
    }
  ],
  "actions": [
    {
      "action": "climate.turn_on",
      "metadata": {},
      "target": {
        "entity_id": "climate.salon_clim_salon_climate"
      },
      "data": {}
    },
    {
      "action": "climate.set_temperature",
      "metadata": {},
      "target": {
        "entity_id": "climate.salon_clim_salon_climate"
      },
      "data": {
        "temperature": 23
      }
    },
    {
      "action": "notify.mobile_app_pixel_8",
      "data": {
        "title": "🌡️ Clim Salon allumée",
        "message": "Température salon {{ states('sensor.capteur_temperature_salon_temperature') }}°C — clim démarrée en mode cool 23°C."
      }
    }
  ],
  "mode": "single"
}